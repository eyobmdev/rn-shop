{
  "expo": {
    "name": "RN SHOP",
    "slug": "rn-shop",
    "scheme": "rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/e-logo2.png",
    "splash": {
      "image": "./app/assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#E63C4B"
    },
    "extra": {
      "eas": {
        "projectId": "965addf4-bd77-480a-bf30-b4f46786d100"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.DoneWithIt"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./app/assets/e-logo.png",
        "backgroundImage": "./app/assets/android-icon-background.png",
        "monochromeImage": "./app/assets/android-icon-monochrome.png"
      },
      "package": "com.anonymous.DoneWithIt"
    },
    "web": {
      "favicon": "./app/assets/logo-red.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "cover",
          "backgroundColor": "#E63C4B",
          "dark": {
            "backgroundColor": "#E63C4B"
          }
        }
      ]
    ]
  }
}